#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/os.sh
source "$SCRIPT_DIR/../lib/os.sh"
require_os macos

dock_changed=0
finder_changed=0

# set_default <domain> <key> <type> <value> <expected `defaults read` output>
# Writes only when the current value differs, so reruns change nothing and
# never restart Dock/Finder. Echoes "changed" when it wrote.
set_default() {
    local domain="$1" key="$2" type="$3" value="$4" expected="$5"
    local current
    current="$(defaults read "$domain" "$key" 2>/dev/null || true)"
    if [ "$current" = "$expected" ]; then
        return 1
    fi
    defaults write "$domain" "$key" "-$type" "$value"
    echo "set $domain $key = $value (was: ${current:-unset})"
}

# Dock
set_default com.apple.dock autohide bool true 1 && dock_changed=1

# Keyboard and trackpad (picked up after logout, no process to restart)
set_default NSGlobalDomain KeyRepeat int 2 2 || true
set_default NSGlobalDomain InitialKeyRepeat int 25 25 || true
set_default NSGlobalDomain AppleInterfaceStyle string Dark Dark || true
set_default NSGlobalDomain com.apple.swipescrolldirection bool false 0 || true

# Finder
set_default com.apple.finder ShowPathbar bool true 1 && finder_changed=1
# Nlsv = list view
set_default com.apple.finder FXPreferredViewStyle string Nlsv Nlsv && finder_changed=1

# Restarting Dock/Finder is pointless (and noisy) on a CI runner.
if [ -z "${CI:-}" ]; then
    if [ "$dock_changed" = 1 ]; then killall Dock || true; fi
    if [ "$finder_changed" = 1 ]; then killall Finder || true; fi
fi

echo "macOS defaults applied"
