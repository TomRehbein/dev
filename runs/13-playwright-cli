#!/usr/bin/env bash

set -e

# @playwright/cli installs its binary as "playwright-cli" (not "playwright" —
# that's the unrelated `playwright` test-runner package).
if command -v playwright-cli &> /dev/null; then
    echo "playwright-cli already installed: $(playwright-cli --version 2>/dev/null || echo 'unknown version')"
else
    # NVM does not export npm to PATH in non-interactive subshells — set it explicitly.
    # Guard against the versions/node directory not existing yet (e.g. nvm not yet used).
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    if [ -d "$NVM_DIR/versions/node" ] && [ -n "$(ls "$NVM_DIR/versions/node" 2>/dev/null)" ]; then
        export PATH="$NVM_DIR/versions/node/$(ls "$NVM_DIR/versions/node" | sort -V | tail -1)/bin:$PATH"
    fi

    npm install -g @playwright/cli@latest
fi

# Pull the Chromium binary now so the first `dev-browser login` doesn't stall
# on a browser download.
npx --yes playwright install chromium

# State dir for dev-browser (see env/.local/scripts/dev-browser) — sessions
# hold authenticated cookies, keep it locked down.
mkdir -p "$HOME/.local/state/dev-browser/sessions"
chmod 700 "$HOME/.local/state/dev-browser" "$HOME/.local/state/dev-browser/sessions"
