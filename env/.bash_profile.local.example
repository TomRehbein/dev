# ~/.bash_profile.local — machine/project-specific config, NOT committed
#
# Copy this file to ~/.bash_profile.local and adapt it.
# It gets sourced at the end of ~/.shell_common.sh, so bash (~/.bash_profile)
# and zsh (~/.zprofile) login shells both pick it up.
#
# Secrets and API keys go here, never into the repo:
# export OPENROUTER_API_KEY=
# export TAVILY_API_KEY=
# export TRELLO_API_KEY=
# export TRELLO_TOKEN=
# export SOME_TOKEN=
#
# Example: project-specific aliases
# alias build="npm run build"
