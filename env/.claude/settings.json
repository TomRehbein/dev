{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "permissions": {
    "allow": [
      "Bash(tmux -L *)",
      "Bash(bun run *)",
      "Bash(bun test *)",
      "Bash(bun test)",
      "Bash(bun install)",
      "Bash(bunx biome *)",
      "Bash(cargo test *)",
      "Bash(cargo test)",
      "Bash(cargo build *)",
      "Bash(cargo build)",
      "Bash(cargo check *)",
      "Bash(cargo check)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git worktree *)",
      "Bash(grep *)",
      "Bash(sed -n *)",
      "Bash(ls *)",
      "Bash(jq *)"
    ],
    "ask": [
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(gh pr merge *)",
      "Bash(glab mr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git -C * merge *)",
      "Bash(git -C * rebase *)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * reset --hard *)"
    ]
  }
}
