# skhd config: global launch-or-focus hotkeys (Meh = ctrl + shift + alt)
# `open -a` starts the app if not running, brings it to front if it is.
ctrl + shift + alt - t : open -a "Microsoft Teams"
ctrl + shift + alt - g : open -a "Ghostty"
ctrl + shift + alt - f : open -a "T3 Code (Nightly)"
ctrl + shift + alt - d : open -a "T3 Code (Beta)"
ctrl + shift + alt - b : open -a "Google Chrome"
ctrl + shift + alt - v : open -a "Vivaldi"
ctrl + shift + alt - c : open -a "Claude"
ctrl + shift + alt - m : open -a "TIDAL"
ctrl + shift + alt - 1 : open -a "1Password"
ctrl + shift + alt - o : open -a "Microsoft Outlook"
ctrl + shift + alt - k : open -a "Keymapp"
ctrl + shift + alt - l : open -a "LocalSend"
ctrl + shift + alt - a : open -a "Bionic"
ctrl + shift + alt - w : open -a "WhatsApp"
ctrl + shift + alt - n : open -a "WireGuard"
